-      } else {
-        res.status(404).send('Not found')
+  return async function (req, res) {
+    let renderState = state
+    let parameterId
+    try {
+      parameterId = decodeURIComponent(req.path.slice(1))
+    } catch (error) {
+      return sendError(res, error)
+    }
+    if (state.parameters[parameterId]) {
+      try {
+        const parameterResponse = await fetchParameter(parameterId)
+        renderState = Object.assign({}, state, {
+          initialParameter: parameterResponse.data,
