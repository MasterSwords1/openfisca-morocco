diff --git a/src/components/parameter-timeline.jsx b/src/components/parameter-timeline.jsx
new file mode 100644
index 0000000..045d88e
--- /dev/null
+++ b/src/components/parameter-timeline.jsx
@@ -0,0 +1,99 @@
+import React from 'react'
+import { FormattedMessage, injectIntl, intlShape } from 'react-intl'
+
+import { parameterShape } from '../openfisca-proptypes'
+
+const width = 700
+const height = 260
+const margin = { top: 20, right: 24, bottom: 42, left: 64 }
+
+class ParameterTimeline extends React.Component {
+  static propTypes = {
+    parameter: parameterShape.isRequired,
+    intl: intlShape.isRequired,
+  };
+
+  render() {
+    const {parameter, intl} = this.props
+    const isScale = !parameter.values
+    const data = (isScale
+      ? Object.keys(parameter.brackets || {}).map(date => {
+        const bracket = parameter.brackets[date] || {}
+        const thresholds = Object.keys(bracket).sort((a, b) => Number(a) - Number(b))
+        return { date, value: thresholds.length ? Number(bracket[thresholds[thresholds.length - 1]]) : null }
+      })
+      : Object.keys(parameter.values || {}).map(date => {
+        const raw = parameter.values[date]
+        const numeric = raw === null || raw === undefined || raw === '' ? null : Number(raw)
+        return { date, value: numeric }
+      }))
+      .filter(point => point.value !== null && !Number.isNaN(point.value))
+      .sort((a, b) => a.date.localeCompare(b.date))
+
+    if (!data.length) return null
+
+    const plotWidth = width - margin.left - margin.right
+    const plotHeight = height - margin.top - margin.bottom
+    const minimum = Math.min(0, ...data.map(point => point.value))
+    const maximum = Math.max(...data.map(point => point.value))
+    const range = maximum - minimum || 1
+    const labelEvery = Math.ceil(data.length / 7)
+    // Thin the date labels and never place two of them side by side.
+    const labelIndices = []
+    for (let index = 0; index < data.length; index += labelEvery) labelIndices.push(index)
+    const lastIndex = data.length - 1
+    if (labelIndices[labelIndices.length - 1] !== lastIndex) {
+      if (lastIndex - labelIndices[labelIndices.length - 1] > 1) labelIndices.push(lastIndex)
+      else labelIndices[labelIndices.length - 1] = lastIndex
+    }
+    const formatValue = value => intl.formatNumber(value, {
+      style: isScale ? 'percent' : 'decimal',
+      maximumFractionDigits: 3,
+    })
+    const formatDate = date => intl.formatDate(new Date(`${date}T00:00:00Z`), {
+      year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
+    })
+    const tooltip = point => `${formatDate(point.date)}: ${formatValue(point.value)}`
+    const x = index => margin.left + (data.length === 1 ? plotWidth / 2 : index * plotWidth / (data.length - 1))
+    const y = value => margin.top + plotHeight - ((value - minimum) / range) * plotHeight
+    const baseline = height - margin.bottom
+    let path = `M ${x(0)} ${y(data[0].value)}`
+    data.slice(1).forEach((point, index) => {
+      path += ` H ${x(index + 1)} V ${y(point.value)}`
+    })
+
+    return (
+      <section className="parameter-timeline">
+        <h4><FormattedMessage id="timelineText"/></h4>
+        {isScale && <p className="timeline-label"><FormattedMessage id="topMarginalRateText"/></p>}
+        <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={isScale
+            ? `${intl.formatMessage({ id: 'timelineText' })}: ${intl.formatMessage({ id: 'topMarginalRateText' })}`
+            : intl.formatMessage({ id: 'timelineText' })}>
+          <line x1={margin.left} y1={margin.top} x2={margin.left} y2={baseline} className="timeline-axis" />
+          <line x1={margin.left} y1={baseline} x2={width - margin.right} y2={baseline} className="timeline-axis" />
+          <text x={margin.left - 8} y={margin.top + 4} textAnchor="end" className="timeline-tick">
+            {formatValue(maximum)}
+          </text>
+          <text x={margin.left - 8} y={baseline} textAnchor="end" className="timeline-tick">
+            {formatValue(minimum)}
+          </text>
+          <path d={path} className="timeline-line">
+            <title>{data.map(tooltip).join(' → ')}</title>
+          </path>
+          {data.map((point, index) => (
+            <g key={point.date}>
+              <circle cx={x(index)} cy={y(point.value)} r="4" className="timeline-point">
+                <title>{tooltip(point)}</title>
+              </circle>
+              {labelIndices.includes(index) &&
+                <text x={x(index)} y={baseline + 20} textAnchor="middle" className="timeline-tick">{formatDate(point.date)}</text>
+              }
+            </g>
+          ))}
+        </svg>
+      </section>
+    )
+  }
+}
+
+export default injectIntl(ParameterTimeline)
